{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Convai Announcements Feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lastUpdated",
    "announcements"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "announcements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "url",
          "date",
          "priority",
          "tags",
          "targetPlatforms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "youtube",
              "blog",
              "update",
              "feature",
              "news",
              "unknown"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https?://"
          },
          "thumbnailUrl": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "priority": {
            "type": "integer"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "targetPlatforms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "minVersion": {
            "type": "string"
          },
          "maxVersion": {
            "type": "string"
          }
        }
      }
    }
  }
}
