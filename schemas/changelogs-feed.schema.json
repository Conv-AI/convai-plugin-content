{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Convai Changelogs Feed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lastUpdated",
    "changelogs"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "changelogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "date",
          "changes",
          "targetPlatforms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "targetPlatforms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
